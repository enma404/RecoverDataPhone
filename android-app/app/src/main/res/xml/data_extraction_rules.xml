<?xml version="1.0" encoding="utf-8"?>
<!--
    data_extraction_rules.xml
    ============================================================
    قواعد النسخ الاحتياطي ونقل البيانات (Android 12+).

    الدور:
      تحديد ما يُسمح بنسخه احتياطياً (Cloud Backup)
      وما يُسمح بنقله بين الأجهزة (Device-to-Device Transfer).

    الأمان:
      - لا نُدرج أي بيانات حساسة (مفاتيح، تراخيص، جلسات).
      - ملفات السجل والذاكرة المؤقتة مستثناة.
      - SharedPreferences مستثناة (تحتوي عنوان السيرفر).

    يشير إليه AndroidManifest.xml:
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:fullBackupContent="false"

    ملاحظة:
      - هذا الملف يُستخدم على Android 12+ (API 31+).
      - على Android 11- يُستخدم android:fullBackupContent بدلاً منه.
      - بما أننا نستخدم android:fullBackupContent="false"،
        فالتطبيق لا يدعم النسخ الاحتياطي أصلاً.
    ============================================================
-->
<data-extraction-rules>

    <!-- ============================================================ -->
    <!-- 1. النسخ الاحتياطي السحابي (Cloud Backup)                    -->
    <!-- ============================================================ -->
    <cloud-backup>

        <!-- ==================================================== -->
        <!-- 1.1 تضمين: ما نريد نسخه احتياطياً                     -->
        <!-- ==================================================== -->
        <include
            domain="sharedpref"
            path="." />

        <include
            domain="file"
            path="config/" />

        <!-- ==================================================== -->
        <!-- 1.2 استثناء: ما لا نريد نسخه احتياطياً (أهم!)         -->
        <!-- ==================================================== -->

        <!-- ملفات السجل -->
        <exclude
            domain="file"
            path="logs/" />

        <!-- ملفات مؤقتة -->
        <exclude
            domain="file"
            path="temp/" />

        <!-- Cache -->
        <exclude
            domain="cache"
            path="." />

        <!-- بيانات الجلسات -->
        <exclude
            domain="file"
            path="sessions/" />

        <!-- مجلد التنزيلات -->
        <exclude
            domain="file"
            path="downloads/" />

        <!-- ==================================================== -->
        <!-- 1.3 SharedPreferences: ما نستثنيه                     -->
        <!-- ==================================================== -->

        <!-- إعدادات السيرفر (يحتوي عنوان محلي) -->
        <exclude
            domain="sharedpref"
            path="server_config_prefs.xml" />

        <!-- بيانات الجلسة الحالية -->
        <exclude
            domain="sharedpref"
            path="session_prefs.xml" />

    </cloud-backup>

    <!-- ============================================================ -->
    <!-- 2. نقل بين الأجهزة (Device-to-Device Transfer)                -->
    <!-- ============================================================ -->
    <device-transfer>

        <!-- ==================================================== -->
        <!-- 2.1 تضمين                                             -->
        <!-- ==================================================== -->
        <include
            domain="sharedpref"
            path="." />

        <!-- ==================================================== -->
        <!-- 2.2 استثناء                                           -->
        <!-- ==================================================== -->

        <!-- ملفات السجل -->
        <exclude
            domain="file"
            path="logs/" />

        <!-- Cache -->
        <exclude
            domain="cache"
            path="." />

        <!-- ملفات مؤقتة -->
        <exclude
            domain="file"
            path="temp/" />

        <!-- بيانات الجلسات -->
        <exclude
            domain="file"
            path="sessions/" />

        <!-- إعدادات السيرفر -->
        <exclude
            domain="sharedpref"
            path="server_config_prefs.xml" />

    </device-transfer>

</data-extraction-rules>