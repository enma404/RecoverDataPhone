<?xml version="1.0" encoding="utf-8"?>
<!--
    network_security_config.xml
    ============================================================
    سياسة الأمان الشبكي للتطبيق.

    القواعد:
      1. القاعدة العامة: منع cleartext (HTTP/WS غير المشفّر)
      2. استثناءات: السماح بـ cleartext للشبكة المحلية فقط

    يشير إليه AndroidManifest.xml:
      android:networkSecurityConfig="@xml/network_security_config"

    متى نسمح بـ cleartext؟
      - ws://192.168.1.2:8765  (السيرفر المحلي في التطوير)
      - ws://10.0.2.2:8765     (Android Emulator → الجهاز المضيف)
      - ws://localhost:8765    (اختبار محلي)
      - ws://127.0.0.1:8765    (نفس الجهاز)

    في الإنتاج (release):
      - العنوان الافتراضي = wss://api.recoverdata.com:8765
      - لا يُستخدم cleartext للإنترنت
    ============================================================
-->
<network-security-config>

    <!-- ============================================================ -->
    <!-- 1. القاعدة العامة (لكل العناوين)                              -->
    <!-- ============================================================ -->
    <!-- افتراضياً: منع أي اتصال غير مشفّر -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- الثقة بشهادات النظام (للـ HTTPS) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- ============================================================ -->
    <!-- 2. استثناءات الشبكة المحلية                                    -->
    <!-- ============================================================ -->
    <!--
        ⚠️ ملاحظة مهمة:
        هذه الاستثناءات تُفعَّل في كل build types (debug + release).
        لمنعها في release، استخدم ملفاً منفصلاً لكل نوع.

        لمشروعنا: نعتمد على أن release يستخدم wss:// بشكل صريح،
        لذا لن يُستخدم عنوان ws:// محلي في الإنتاج.
    -->
    <domain-config cleartextTrafficPermitted="true">

        <!-- ==================================================== -->
        <!-- 2.1 السيرفر المحلي (غيّر 192.168.1.2 إلى IP جهازك) -->
        <!-- ==================================================== -->
        <domain includeSubdomains="false">192.168.1.2</domain>

        <!-- ==================================================== -->
        <!-- 2.2 Android Emulator                                -->
        <!-- 10.0.2.2 = عنوان الجهاز المضيف من داخل المحاكي    -->
        <!-- ==================================================== -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- ==================================================== -->
        <!-- 2.3 اختبار محلي                                     -->
        <!-- ==================================================== -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

    </domain-config>

    <!-- ============================================================ -->
    <!-- 3. (اختياري) استثناء نطاق كامل للشبكة المحلية                 -->
    <!-- ============================================================ -->
    <!--
        إذا كنت تريد السماح بكل عناوين 192.168.x.x دون تحديد IP واحد:

        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="true">192.168.0.0</domain>
            <domain includeSubdomains="true">192.168.1.0</domain>
        </domain-config>

        ⚠️ لكن هذا أقل أماناً، ولا يدعم IP range حقيقي.
        الأفضل: أضف IP جهازك صراحة في القسم 2.1.
    -->

</network-security-config>