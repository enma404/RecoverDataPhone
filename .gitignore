# ============================================================
# RecoverDataPhone - .gitignore
# ============================================================
# يستبعد الملفات التي لا يجب رفعها إلى Git.
#
# ⚠️ تحذير: بعض هذه الملفات حساسة (مفاتيح، تراخيص، بيانات عملاء)
#    لا ترفعها أبداً حتى لو كان المستودع خاصاً.
# ============================================================


# ============================================================
# 1. 🔑 مفاتيح التشفير (حرج! لا ترفع أبداً)
# ============================================================
server/storage/keys/
*.pem
*.key
*.p12
*.jks
*.keystore
*.pfx
*.cert
*.crt


# ============================================================
# 2. 🔒 بيانات العملاء والتراخيص (حرج! خصوصية)
# ============================================================
# البيانات المسترجعة
server/storage/received/
server/storage/temp/

# التراخيص
server/storage/licenses.json
server/storage/licenses.json.tmp

# سجل التدقيق
server/storage/audit/
server/storage/audit/*.jsonl

# ملفات مؤقتة
server/storage/*.tmp


# ============================================================
# 3. 📝 السجلات (Logs)
# ============================================================
server/logs/
logs/
log/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ============================================================
# 4. ⚙️ الإعدادات المحلية (قد تحتوي أسرار)
# ============================================================
.env
.env.*
!.env.example
*.env.local
config.local.json
server/config.local.json

# keystore.properties (يحتوي كلمات سر التوقيع)
android-app/keystore.properties
keystore.properties


